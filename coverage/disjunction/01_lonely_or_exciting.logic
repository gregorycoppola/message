# If someone lives alone, they are either lonely or find it exciting.

predicate lives_alone {theme: e}
predicate lonely {theme: e}
predicate finds_exciting {theme: e}

entity alice : e

lives_alone(theme: alice)

rule [x:e]: lives_alone(theme: x) -> lonely(theme: x)
rule [x:e]: lives_alone(theme: x) -> finds_exciting(theme: x)

? lonely(theme: alice)