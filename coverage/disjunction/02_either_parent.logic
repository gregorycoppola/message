# Alice is Bob's mother. Carol is Bob's father. If someone is a person's mother or father, they are that person's parent.

predicate mother_of {agent: e, patient: e}
predicate father_of {agent: e, patient: e}
predicate parent_of {agent: e, patient: e}

entity alice : e
entity bob : e
entity carol : e

mother_of(agent: alice, patient: bob)
father_of(agent: carol, patient: bob)

always [x:e, y:e]: mother_of(agent: x, patient: y) -> parent_of(agent: x, patient: y)
always [x:e, y:e]: father_of(agent: x, patient: y) -> parent_of(agent: x, patient: y)

? parent_of(agent: alice, patient: bob)