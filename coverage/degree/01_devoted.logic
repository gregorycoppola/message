# Mary really loves Henry. If a girl really loves a man, she is devoted.

predicate girl {theme: e}
predicate man {theme: e}
predicate love {agent: e, patient: e, degree: e}
predicate devoted {theme: e}

entity mary : e
entity henry : e
entity high : e

girl(theme: mary)
man(theme: henry)
love(agent: mary, patient: henry, degree: high)

always [x:e, y:e]: girl(theme: x) & love(agent: x, patient: y, degree: high) & man(theme: y) -> devoted(theme: x)

? devoted(theme: mary)