# Mary loves a man who is tall. If a girl loves a tall man, she is romantic.

predicate girl {theme: e}
predicate man {theme: e}
predicate tall {theme: e}
predicate love {agent: e, patient: e}
predicate romantic {theme: e}

entity mary : e
entity m1 : e

girl(theme: mary)
man(theme: m1)
tall(theme: m1)
love(agent: mary, patient: m1)

always [x:e, y:e]: girl(theme: x) & love(agent: x, patient: y) & man(theme: y) & tall(theme: y) -> romantic(theme: x)

? romantic(theme: mary)