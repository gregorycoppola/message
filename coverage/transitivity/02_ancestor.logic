# Alice is Bob's parent. Bob is Carol's parent.

predicate parent_of {agent: e, patient: e}
predicate grandparent_of {agent: e, patient: e}

entity alice : e
entity bob : e
entity carol : e

parent_of(agent: alice, patient: bob)
parent_of(agent: bob, patient: carol)

rule [x:e, y:e, z:e]: parent_of(agent: x, patient: y) & parent_of(agent: y, patient: z) -> grandparent_of(agent: x, patient: z)

? grandparent_of(agent: alice, patient: carol)