# Mary speaks French. Mary speaks Spanish. If someone speaks two languages, they are bilingual.

predicate speak {agent: e, patient: e}
predicate language {theme: e}
predicate bilingual {theme: e}
predicate not_equal {theme: e, reference: e}

entity mary : e
entity french : e
entity spanish : e

language(theme: french)
language(theme: spanish)
speak(agent: mary, patient: french)
speak(agent: mary, patient: spanish)
not_equal(theme: french, reference: spanish)

always [x:e, l1:e, l2:e]: speak(agent: x, patient: l1) & speak(agent: x, patient: l2) & language(theme: l1) & language(theme: l2) & not_equal(theme: l1, reference: l2) -> bilingual(theme: x)

? bilingual(theme: mary)