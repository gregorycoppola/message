# If John is married to Mary, then Mary is married to John. John is married to Mary.

predicate married {agent: e, patient: e}

entity john : e
entity mary : e

married(agent: john, patient: mary)

always [x:e, y:e]: married(agent: x, patient: y) -> married(agent: y, patient: x)

? married(agent: mary, patient: john)