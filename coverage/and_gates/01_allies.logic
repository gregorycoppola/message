# Jack trusts Jill. Jill trusts Jack. If two people trust each other, they are allies.

entity jack : e
entity jill : e

trust(agent: jack, patient: jill)
trust(agent: jill, patient: jack)

rule [x:e, y:e]: trust(agent: x, patient: y) & trust(agent: y, patient: x) -> allied(agent: x, patient: y)

? allied(agent: jack, patient: jill)