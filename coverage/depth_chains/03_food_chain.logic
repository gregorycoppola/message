# A sparrow is a bird. All birds are animals. All animals are organisms. All organisms are mortal.

predicate bird {theme: e}
predicate animal {theme: e}
predicate organism {theme: e}
predicate mortal {theme: e}

entity sparrow1 : e

bird(theme: sparrow1)

always [x:e]: bird(theme: x) -> animal(theme: x)
always [x:e]: animal(theme: x) -> organism(theme: x)
always [x:e]: organism(theme: x) -> mortal(theme: x)

? mortal(theme: sparrow1)