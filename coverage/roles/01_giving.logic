# John gave Mary a book.

predicate give {agent: e, patient: e, recipient: e}
predicate have {agent: e, patient: e}

entity john : e
entity mary : e
entity book1 : e

give(agent: john, patient: book1, recipient: mary)

always [x:e, y:e, z:e]: give(agent: x, patient: y, recipient: z) -> have(agent: z, patient: y)

? have(agent: mary, patient: book1)