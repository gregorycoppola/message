# Alice sent a letter to Bob from London.

predicate send {agent: e, patient: e, recipient: e, source: e}
predicate receive {agent: e, patient: e}

entity alice : e
entity bob : e
entity letter1 : e
entity london : e

send(agent: alice, patient: letter1, recipient: bob, source: london)

rule [a:e, p:e, r:e, s:e]: send(agent: a, patient: p, recipient: r, source: s) -> receive(agent: r, patient: p)

? receive(agent: bob, patient: letter1)