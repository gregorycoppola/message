# Jack trusted Jill in the past. If someone trusted someone in the past,
# they probably still trust them now.

entity jack : e
entity jill : e

trust(agent: jack, patient: jill, time: past)

rule [x:e, y:e] (0.7): trust(agent: x, patient: y, time: past) -> trust(agent: x, patient: y, time: present)

? trust(agent: jack, patient: jill, time: present)