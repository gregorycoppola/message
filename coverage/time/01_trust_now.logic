# Jack trusted Jill in the past. If someone trusted someone in the past, they probably still trust them now.

predicate trust {agent: e, patient: e, time: e}

entity jack : e
entity jill : e
entity past : e
entity present : e

trust(agent: jack, patient: jill, time: past)

usually [x:e, y:e]: trust(agent: x, patient: y, time: past) -> trust(agent: x, patient: y, time: present)

? trust(agent: jack, patient: jill, time: present)