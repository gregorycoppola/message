# Paris is the capital of France. The capital of France is the largest city in France.

predicate capital_of {theme: e, reference: e}
predicate largest_city_in {theme: e, reference: e}

entity paris : e
entity france : e

capital_of(theme: paris, reference: france)
largest_city_in(theme: paris, reference: france)

? largest_city_in(theme: paris, reference: france)